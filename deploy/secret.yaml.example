# Copy to secret.yaml (do not commit) and fill in real tokens, then:
#   oc apply -f deploy/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: opdev-cluster-bot-slack
  namespace: opdev-cluster-bot
  labels:
    app.kubernetes.io/name: opdev-cluster-bot
type: Opaque
stringData:
  SLACK_BOT_TOKEN: "xoxb-replace-me"
  SLACK_APP_TOKEN: "xapp-replace-me"
