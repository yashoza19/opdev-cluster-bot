# Example secrets for Hive provisioning (apply to opdev-cluster-bot-creds).
# Do not commit real credentials.
---
apiVersion: v1
kind: Secret
metadata:
  name: aws-creds
  namespace: opdev-cluster-bot-creds
type: Opaque
stringData:
  # Hive AWS credentials secret typically uses these keys:
  aws_access_key_id: "AKIA..."
  aws_secret_access_key: "..."
---
apiVersion: v1
kind: Secret
metadata:
  name: pull-secret
  namespace: opdev-cluster-bot-creds
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: |
    {"auths":{}}
---
apiVersion: v1
kind: Secret
metadata:
  name: ssh-privatekey
  namespace: opdev-cluster-bot-creds
type: Opaque
stringData:
  ssh-privatekey: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    replace-me
    -----END OPENSSH PRIVATE KEY-----
