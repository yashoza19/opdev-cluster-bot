apiVersion: v1
metadata:
  name: '{{ cluster_name }}'
baseDomain: {{ base_domain }}
controlPlane:
  hyperthreading: Enabled
  name: master
  replicas: {{ control_plane_replicas }}
  platform:
    aws:
      type: {{ instance_type }}
{#
  Always emit an explicit worker pool. An empty `compute: []` is treated by
  openshift-install as "use HA defaults" (replicas=3, default instance type).
  SNO requires compute.replicas: 0 per OpenShift docs.
#}
compute:
- hyperthreading: Enabled
  name: worker
  replicas: {{ compute_replicas }}
{% if compute_replicas > 0 %}
  platform:
    aws:
      type: {{ instance_type }}
{% else %}
  platform: {}
{% endif %}
networking:
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: 10.0.0.0/16
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  aws:
    region: {{ aws_region }}
pullSecret: ""  # provided via ClusterDeployment pullSecretRef
sshKey: ""      # provided via sshPrivateKeySecretRef when present
