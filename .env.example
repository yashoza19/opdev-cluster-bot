# Slack Socket Mode
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# AWS / Hive provision defaults
AWS_REGION=us-east-1
BASE_DOMAIN=dev.example.com
CREDS_NAMESPACE=opdev-cluster-bot-creds
AWS_CREDS_SECRET=aws-creds
PULL_SECRET_NAME=pull-secret
SSH_SECRET_NAME=ssh-privatekey

# Bot behavior
REMINDER_CHANNEL=
ADMIN_SLACK_GROUP_IDS=
DEFAULT_COMPUTE_REPLICAS=3
SNO_MIN_INSTANCE_TYPE=m5.2xlarge
MAX_CONCURRENT_PROVISIONS=3
DRY_RUN=false
MANAGED_BY_LABEL=opdev-cluster-bot
